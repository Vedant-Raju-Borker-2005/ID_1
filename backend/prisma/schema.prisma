datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  name              String?
  avatarUrl         String?
  verificationToken String?           @unique
  isVerified        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  workspaces        WorkspaceMember[]
  activityLogs      ActivityLog[]
  assignedResources Resource[]
  refreshTokens     RefreshToken[]
  notifications     Notification[]
  ownedWorkspaces   Workspace[]
  vendor            Vendor?
}

model Workspace {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  plan         String            @default("FREE")
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  resources    Resource[]
  automations  AutomationRule[]
  integrations Integration[]
  projects     Project[]
  vendors      Vendor[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
}

model Resource {
  id          String    @id @default(uuid())
  type        String    // task, document, issue, etc.
  title       String
  content     String?
  status      String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model AutomationRule {
  id          String    @id @default(uuid())
  name        String
  trigger     String    @db.VarChar(50) // 'status_changed', 'date_based', 'cron'
  conditions  Json?
  actions     Json
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  enabled     Boolean   @default(true)
}

model Integration {
  id          String    @id @default(uuid())
  type        String    // 'slack', 'jira', 'github'
  credentials Json
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())
}

model AIUsage {
  id          String   @id @default(uuid())
  workspaceId String
  feature     String   // 'writing', 'chat', 'summarize'
  tokensUsed  Int
  cost        Decimal
  createdAt   DateTime @default(now())
}

model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  deviceFingerprint String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info") // info, warning, error, success
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
}

model Project {
  id          String   @id @default(uuid())
  name        String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  assignments VendorAssignment[]
}

model Vendor {
  id              String    @id @default(cuid())
  userId          String    @unique
  workspaceId     String?
  businessName    String
  ownerName       String
  email           String    @unique
  phone           String?
  gstNumber       String?
  panNumber       String?
  warehouseAddress String?
  serviceLocations String[]
  status          VendorStatus @default(SUBMITTED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id])
  workspace       Workspace? @relation(fields: [workspaceId], references: [id])
  profile         VendorProfile?
  products        VendorProduct[]
  assignments     VendorAssignment[]
  payouts         VendorPayout[]
  notifications   VendorNotification[]
  performance     VendorPerformance?

  @@map("vendors")
}

enum VendorStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VendorProfile {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  gstCertificate  String?  // S3 URL
  panCard         String?  // S3 URL
  bankDetails     String?  // S3 URL
  approvalStatus  String   @default("PENDING")
  rejectionReason String?
  approvedBy      String?  // Admin User ID
  approvedAt      DateTime?

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
}

model VendorProduct {
  id              String   @id @default(cuid())
  vendorId        String
  name            String
  category        String
  subcategory     String
  sku             String   @unique
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  images          String[] // S3 URLs
  variants        ProductVariant[]
  inventory       Inventory?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  color           String?
  material        String?
  size            String?
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  skuSuffix       String?

  product         VendorProduct @relation(fields: [productId], references: [id])
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  availableQty    Int      @default(0)
  reservedQty     Int      @default(0)
  incomingQty     Int      @default(0)
  lastUpdated     DateTime @updatedAt

  product         VendorProduct @relation(fields: [productId], references: [id])
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  productId       String
  type            String   // ADDED, RESERVED, RELEASED, DELIVERED
  quantity        Int
  referenceId     String?  // Assignment ID
  notes           String?
  createdAt       DateTime @default(now())

  @@map("inventory_transactions")
}

model VendorAssignment {
  id              String   @id @default(cuid())
  projectId       String
  itemId          String
  vendorId        String
  status          AssignmentStatus @default(ASSIGNED)
  remarks         String?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  project         Project  @relation(fields: [projectId], references: [id])
  
  @@map("vendor_assignments")
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  PENDING
}

model ItemStatusHistory {
  id              String   @id @default(cuid())
  assignmentId    String
  status          String
  updatedBy       String   // Vendor User ID
  remarks         String?
  timestamp       DateTime @default(now())

  @@map("item_status_history")
}

model ItemProofImage {
  id              String   @id @default(cuid())
  assignmentId    String
  imageUrl        String   // S3 URL
  imageType       String   // PRODUCTION, PACKAGING, DISPATCH, DELIVERY, INSTALLATION
  caption         String?
  uploadedAt      DateTime @default(now())

  @@map("item_proof_images")
}

model VendorPayout {
  id              String   @id @default(cuid())
  vendorId        String
  amount          Decimal  @db.Decimal(10, 2)
  projectId       String
  payoutDate      DateTime?
  status          PayoutStatus @default(PENDING)
  statementUrl    String?  // PDF S3 URL
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model VendorNotification {
  id              String   @id @default(cuid())
  vendorId        String
  type            String   // NEW_ASSIGNMENT, STATUS_UPDATE, PAYOUT_RELEASED, DELAY_ALERT
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_notifications")
}

model VendorPerformance {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  acceptanceRate  Float    @default(0)
  completionRate  Float    @default(0)
  delayPercentage Float    @default(0)
  customerRating  Float    @default(0)
  avgDeliveryTime Int      @default(0) // in days
  lastUpdated     DateTime @updatedAt

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_performance")
}

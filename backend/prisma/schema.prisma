datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String            @id @default(uuid())
  email              String            @unique
  passwordHash       String
  name               String?
  avatarUrl          String?
  verificationToken  String?           @unique
  isVerified         Boolean           @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  workspaces         WorkspaceMember[]
  activityLogs       ActivityLog[]
  assignedResources  Resource[]
  refreshTokens      RefreshToken[]
  notifications      Notification[]
  ownedWorkspaces    Workspace[]
  vendor             Vendor?
  teamMembers        ProjectTeamMember[]
  projectAssignments ProjectAssignment[] @relation("AssignmentAssignee")
  createdAssignments ProjectAssignment[] @relation("AssignmentCreator")
  assignedTasks      Task[]              @relation("TaskAssignee")
  createdTasks       Task[]              @relation("TaskCreator")
  executionIssues    ExecutionIssue[]
  siteVisits         SiteVisit[]
}

model Workspace {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  plan         String            @default("FREE")
  ownerId      String
  owner        User              @relation(fields: [ownerId], references: [id])
  members      WorkspaceMember[]
  resources    Resource[]
  automations  AutomationRule[]
  integrations Integration[]
  projects     Project[]
  vendors      Vendor[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model WorkspaceMember {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  role        String    @default("MEMBER") // OWNER, ADMIN, MEMBER, VIEWER
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, userId])
}

model Resource {
  id          String    @id @default(uuid())
  type        String    // task, document, issue, etc.
  title       String
  content     String?
  status      String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  assigneeId  String?
  assignee    User?     @relation(fields: [assigneeId], references: [id])
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
}

model AutomationRule {
  id          String    @id @default(uuid())
  name        String
  trigger     String    @db.VarChar(50) // 'status_changed', 'date_based', 'cron'
  conditions  Json?
  actions     Json
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  enabled     Boolean   @default(true)
}

model Integration {
  id          String    @id @default(uuid())
  type        String    // 'slack', 'jira', 'github'
  credentials Json
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ActivityLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  createdAt    DateTime @default(now())
}

model AIUsage {
  id          String   @id @default(uuid())
  workspaceId String
  feature     String   // 'writing', 'chat', 'summarize'
  tokensUsed  Int
  cost        Decimal
  createdAt   DateTime @default(now())
}

model RefreshToken {
  id                String   @id @default(uuid())
  token             String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  deviceFingerprint String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("info") // info, warning, error, success
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())
}

model Project {
  id                 String   @id @default(uuid())
  name               String
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  assignments        VendorAssignment[]
  teamMembers        ProjectTeamMember[]
  projectAssignments ProjectAssignment[]
  photos             ExecutionPhoto[]
  issues             ExecutionIssue[]
  itemTrackings      ProjectItemTracking[]
  progressHistory    ProjectProgressHistory[]
  tasks              Task[]
  dailyChecklists    DailyChecklist[]
  siteVisits         SiteVisit[]
  delays             ProjectDelay[]
  commsLogs          CommunicationLog[]
  documents          ProjectDocument[]
}

model Vendor {
  id              String    @id @default(cuid())
  userId          String    @unique
  workspaceId     String?
  businessName    String
  ownerName       String
  email           String    @unique
  phone           String?
  gstNumber       String?
  panNumber       String?
  warehouseAddress String?
  serviceLocations String[]
  status          VendorStatus @default(SUBMITTED)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user            User      @relation(fields: [userId], references: [id])
  workspace       Workspace? @relation(fields: [workspaceId], references: [id])
  profile         VendorProfile?
  products        VendorProduct[]
  assignments     VendorAssignment[]
  payouts         VendorPayout[]
  notifications   VendorNotification[]
  performance     VendorPerformance?

  @@map("vendors")
}

enum VendorStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model VendorProfile {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  gstCertificate  String?  // S3 URL
  panCard         String?  // S3 URL
  bankDetails     String?  // S3 URL
  approvalStatus  String   @default("PENDING")
  rejectionReason String?
  approvedBy      String?  // Admin User ID
  approvedAt      DateTime?

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
}

model VendorProduct {
  id              String   @id @default(cuid())
  vendorId        String
  name            String
  category        String
  subcategory     String
  sku             String   @unique
  description     String?
  basePrice       Decimal  @db.Decimal(10, 2)
  images          String[] // S3 URLs
  variants        ProductVariant[]
  inventory       Inventory?
  isArchived      Boolean  @default(false)
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
}

model ProductVariant {
  id              String   @id @default(cuid())
  productId       String
  color           String?
  material        String?
  size            String?
  priceAdjustment Decimal  @default(0) @db.Decimal(10, 2)
  skuSuffix       String?

  product         VendorProduct @relation(fields: [productId], references: [id])
}

model Inventory {
  id              String   @id @default(cuid())
  productId       String   @unique
  availableQty    Int      @default(0)
  reservedQty     Int      @default(0)
  incomingQty     Int      @default(0)
  lastUpdated     DateTime @updatedAt

  product         VendorProduct @relation(fields: [productId], references: [id])
}

model InventoryTransaction {
  id              String   @id @default(cuid())
  productId       String
  type            String   // ADDED, RESERVED, RELEASED, DELIVERED
  quantity        Int
  referenceId     String?  // Assignment ID
  notes           String?
  createdAt       DateTime @default(now())

  @@map("inventory_transactions")
}

model VendorAssignment {
  id              String   @id @default(cuid())
  projectId       String
  itemId          String
  vendorId        String
  status          AssignmentStatus @default(ASSIGNED)
  remarks         String?
  acceptedAt      DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  project         Project  @relation(fields: [projectId], references: [id])
  
  @@map("vendor_assignments")
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  PENDING
}

model ItemStatusHistory {
  id              String   @id @default(cuid())
  assignmentId    String
  status          String
  updatedBy       String   // Vendor User ID
  remarks         String?
  timestamp       DateTime @default(now())

  @@map("item_status_history")
}

model ItemProofImage {
  id              String   @id @default(cuid())
  assignmentId    String
  imageUrl        String   // S3 URL
  imageType       String   // PRODUCTION, PACKAGING, DISPATCH, DELIVERY, INSTALLATION
  caption         String?
  uploadedAt      DateTime @default(now())

  @@map("item_proof_images")
}

model VendorPayout {
  id              String   @id @default(cuid())
  vendorId        String
  amount          Decimal  @db.Decimal(10, 2)
  projectId       String
  payoutDate      DateTime?
  status          PayoutStatus @default(PENDING)
  statementUrl    String?  // PDF S3 URL
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_payouts")
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
}

model VendorNotification {
  id              String   @id @default(cuid())
  vendorId        String
  type            String   // NEW_ASSIGNMENT, STATUS_UPDATE, PAYOUT_RELEASED, DELAY_ALERT
  message         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_notifications")
}

model VendorPerformance {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  acceptanceRate  Float    @default(0)
  completionRate  Float    @default(0)
  delayPercentage Float    @default(0)
  customerRating  Float    @default(0)
  avgDeliveryTime Int      @default(0) // in days
  lastUpdated     DateTime @updatedAt

  vendor          Vendor   @relation(fields: [vendorId], references: [id])
  
  @@map("vendor_performance")
}

// --- NEW: PROJECT TEAM MODULE MODELS ---

model ProjectTeamMember {
  id              String      @id @default(cuid())
  projectId       String
  userId          String
  role            TeamRole    // Manager, Coordinator, Technician
  status          MemberStatus // Active, OnLeave, Removed
  assignedAt      DateTime    @default(now())
  
  project         Project     @relation(fields: [projectId], references: [id])
  user            User        @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([projectId, role])
}

enum TeamRole {
  MANAGER
  COORDINATOR
  TECHNICIAN
}

enum MemberStatus {
  ACTIVE
  ON_LEAVE
  REMOVED
}

model ProjectAssignment {
  id            String      @id @default(cuid())
  projectId     String
  assigneeId    String      // User ID of Coordinator/Technician
  assignedById  String      // User ID of Manager/Admin
  role          TeamRole
  targetItemId  String?     // Specific item within project if assigned to task
  assignedAt    DateTime    @default(now())
  
  project       Project     @relation(fields: [projectId], references: [id])
  assignee      User        @relation("AssignmentAssignee", fields: [assigneeId], references: [id])
  creator       User        @relation("AssignmentCreator", fields: [assignedById], references: [id])

  @@index([projectId, role])
}

model ExecutionPhoto {
  id            String   @id @default(cuid())
  projectId     String
  roomName      String?  // Optional context for photo
  category      PhotoCategory // SiteVisit, ProductionCheck, Delivery, Installation, FinalHandover
  imageUrl      String
  uploadedBy    String
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, category])
}

enum PhotoCategory {
  SITE_VISIT
  PRODUCTION_CHECK
  DELIVERY
  INSTALLATION
  FINAL_HANDOVER
}

model ExecutionIssue {
  id            String   @id @default(cuid())
  projectId     String
  itemId        String?  // Optional link to specific item
  type          IssueType
  priority      Priority
  status        IssueStatus
  description   String
  resolution    String?
  resolvedAt    DateTime?
  createdById   String

  project       Project  @relation(fields: [projectId], references: [id])
  createdBy     User     @relation(fields: [createdById], references: [id])

  @@index([projectId, status])
}

enum IssueType {
  VENDOR_DELAY
  DAMAGED_PRODUCT
  WRONG_PRODUCT
  MISSING_ITEM
  INSTALLATION_PROBLEM
  CUSTOMER_COMPLAINT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

model ProjectItemTracking {
  id            String   @id @default(cuid())
  projectId     String
  itemSerialId  String?  // Link to specific SKU/Order Item
  currentStatus ItemStatus
  expectedDate  DateTime?
  actualDate    DateTime?
  updatedBy     String
  
  project       Project  @relation(fields: [projectId], references: [id])

  @@index([itemSerialId, projectId])
}

enum ItemStatus {
  ORDERED
  PRODUCTION
  READY
  DISPATCHED
  DELIVERED
  INSTALLED
}

model ProjectProgressHistory {
  id            String   @id @default(cuid())
  projectId     String
  progress      Float    // 0.0 to 100.0
  reason        String?  // e.g., "Delivery Completed"
  recordedAt    DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, recordedAt])
}

model Task {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  description   String?
  assignedTo    String?  // User ID (Technician/Coordinator)
  assignedBy    String
  dueDate       DateTime
  priority      Priority
  status        TaskStatus
  
  project       Project  @relation(fields: [projectId], references: [id])
  assignee      User?    @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator       User     @relation("TaskCreator", fields: [assignedBy], references: [id])

  @@index([assignedTo, status])
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model DailyChecklist {
  id            String   @id @default(cuid())
  projectId     String
  checklistType ChecklistType // CoordinatorCheck, TechnicianCheck
  items         Json     // Array of { title, checked }
  completedBy   String?
  createdAt     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id])
}

enum ChecklistType {
  COORDINATOR_CHECK
  TECHNICIAN_CHECK
}

model SiteVisit {
  id            String    @id @default(cuid())
  projectId     String
  visitDate     DateTime
  assignedTo    String?   // User ID
  notes         String?
  outcome       String?
  status        VisitStatus
  
  project       Project   @relation(fields: [projectId], references: [id])
  assignee      User?     @relation(fields: [assignedTo], references: [id])

  @@index([visitDate, status])
}

enum VisitStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ProjectDelay {
  id            String    @id @default(cuid())
  projectId     String
  reason        String
  severity      Severity  // Low, Medium, High
  detectedAt    DateTime  @default(now())
  resolvedAt    DateTime?

  project       Project   @relation(fields: [projectId], references: [id])

  @@index([severity, projectId])
}

enum Severity {
  LOW
  MEDIUM
  HIGH
}

model CommunicationLog {
  id            String   @id @default(cuid())
  projectId     String
  type          CommsType // Call, Email, WhatsApp, Meeting
  notes         String
  createdBy     String
  timestamp     DateTime @default(now())

  project       Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, timestamp])
}

enum CommsType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
}

model ProjectDocument {
  id            String   @id @default(cuid())
  projectId     String
  title         String
  type          DocType  // Quotation, Invoice, FloorPlan, SiteReport, Certificate
  url           String
  version       Int      @default(1)
  
  project       Project  @relation(fields: [projectId], references: [id])

  @@index([projectId, type])
}

enum DocType {
  QUOTATION
  INVOICE
  FLOOR_PLAN
  SITE_REPORT
  COMPLETION_CERTIFICATE
}
